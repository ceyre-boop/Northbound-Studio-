---
import Base from '../layouts/Base.astro';
import content from '../content/content.json';
const { about, business: b } = content;
---
<Base title="About" description="Ridgeline Roofing — three crews working Eaton and Ingham counties since 2015." sticky={true}>
  <section class="section">
    <div class="wrap ab">
      <div>
        <p class="eyebrow">About</p>
        <h1>{about.heading}</h1>
        {about.body.map((p) => <p class="ab__p">{p}</p>)}
      </div>
      <aside>
        <ul class="ab__stats">
          {about.stats.map((s) => (
            <li><span class="ab__v">{s.value}</span><span class="ab__l">{s.label}</span></li>
          ))}
        </ul>
        <p class="ab__meta">{b.address}<br />{b.license}</p>
      </aside>
    </div>
  </section>
</Base>
<style>
  .ab { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.6fr); gap: clamp(2rem, 6vw, 4.5rem); align-items: start; }
  .ab h1 { margin: 0.7rem 0 1.5rem; }
  .ab__p { font-size: 1.05rem; margin-bottom: 1.1rem; }
  .ab__stats { list-style: none; margin: 0 0 1.5rem; padding: 0; border-top: 2px solid var(--orange); }
  .ab__stats li { display: grid; gap: 0.15rem; padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .ab__v { font-family: var(--display); font-weight: 700; font-size: 2rem; line-height: 1; }
  .ab__l { font-size: 0.9rem; color: var(--muted); }
  .ab__meta { font-size: 0.92rem; color: var(--muted); }
  @media (max-width: 860px) { .ab { grid-template-columns: 1fr; } }
</style>
