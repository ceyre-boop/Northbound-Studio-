---
// The thing a trades owner recognises instantly: once the hero is gone, Call and
// Book are permanently under the thumb. Mobile only.
const { phoneHref } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<div class="sticky" id="stickybar" data-hidden="true" aria-hidden="true" inert>
  <a class="sticky__btn sticky__btn--call" href={phoneHref}>
    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/></svg>
    Call
  </a>
  <a class="sticky__btn sticky__btn--book" href={`${base}/book`}>Book an inspection</a>
</div>

<script>
  const bar = document.getElementById('stickybar');
  const sentinel = document.getElementById('hero-end');
  if (bar && sentinel) {
    const io = new IntersectionObserver(([e]) => {
      const show = !e.isIntersecting && e.boundingClientRect.top < 0;
      bar.dataset.hidden = show ? 'false' : 'true';
      bar.setAttribute('aria-hidden', show ? 'false' : 'true');
      // Without this the two links stay in the tab order while the bar is
      // parked off-screen, which is a keyboard trap in all but name.
      if (show) bar.removeAttribute('inert');
      else bar.setAttribute('inert', '');
    }, { threshold: 0 });
    io.observe(sentinel);
  }
</script>

<style>
  .sticky {
    position: fixed; inset: auto 0 0 0; z-index: 40;
    display: grid; grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr);
    gap: 8px; padding: 8px calc(var(--gut) * 0.6) calc(8px + env(safe-area-inset-bottom));
    background: rgba(22, 21, 15, 0.94);
    backdrop-filter: blur(12px);
    border-top: 1px solid var(--line-dark);
    transform: translateY(0);
    transition: transform .28s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sticky[data-hidden="true"] { transform: translateY(110%); pointer-events: none; visibility: hidden; }
  .sticky__btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.45rem;
    min-height: 50px; border-radius: var(--r); text-decoration: none;
    font-family: var(--display); font-weight: 600; font-size: 1rem;
  }
  .sticky__btn--call { background: var(--paper); color: var(--ink); }
  .sticky__btn--book { background: var(--orange); color: var(--orange-ink); }
  @media (min-width: 861px) { .sticky { display: none; } }
  @media (prefers-reduced-motion: reduce) { .sticky { transition: none; } }
</style>
