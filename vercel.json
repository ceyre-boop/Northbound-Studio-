{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'static site: no install'",
  "buildCommand": "node -e \"const f=require('fs'),p='data/release.json';if(process.env.VERCEL_ENV!=='production')f.writeFileSync(p,'{}');else if(!f.existsSync(p)){console.error('Prod ships via: bun run ship');process.exit(1)}\"",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/demos/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/data/price.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/data/perf-budget.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/data/release.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/connect/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'sha256-suHuVApJvQdtnGOJFro+yaR0QjzOfwkFik3Ye8nULhI='; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/free",
      "destination": "/free.html"
    },
    {
      "source": "/demos/atlas",
      "destination": "https://nb-atlas.vercel.app/"
    },
    {
      "source": "/demos/atlas/",
      "destination": "https://nb-atlas.vercel.app/"
    },
    {
      "source": "/demos/atlas/:path*",
      "destination": "https://nb-atlas.vercel.app/:path*"
    },
    {
      "source": "/demos/vector",
      "destination": "https://nb-vector.vercel.app/"
    },
    {
      "source": "/demos/vector/",
      "destination": "https://nb-vector.vercel.app/"
    },
    {
      "source": "/demos/vector/:path*",
      "destination": "https://nb-vector.vercel.app/:path*"
    }
  ],
  "functions": {
    "api/*.ts": {
      "includeFiles": "data/price.json"
    }
  },
  "redirects": [
    {
      "source": "/(api|lib|engines)/(.*)\\.(ts|mjs|cjs|map)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/templates/(.*)\\.(ts|md)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/brand-src/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/VISION.md",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/README.md",
      "destination": "/",
      "permanent": false
    }
  ]
}
