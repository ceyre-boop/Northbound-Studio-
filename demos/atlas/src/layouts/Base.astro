---
import '@fontsource-variable/archivo';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/600.css';
import '../styles/global.css';
import content from '../content/content.json';
import FictionBar from '../components/FictionBar.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StickyCallBar from '../components/StickyCallBar.astro';

const { title, description, sticky = false } = Astro.props;
const b = content.business;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- Reachable, not ranked: these are concept builds, not a business. -->
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#16150F" />
  <title>{title} — Ridgeline Roofing</title>
  <meta name="description" content={description} />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='3' fill='%23E4560E'/%3E%3Ctext x='16' y='23' font-family='Arial,sans-serif' font-size='19' font-weight='700' fill='%23FFF6F1' text-anchor='middle'%3ER%3C/text%3E%3C/svg%3E" />
</head>
<body>
  <FictionBar business={b.name} />
  <SiteHeader phone={b.phone} phoneHref={b.phoneHref} />
  <main id="main">
    <slot />
  </main>
  <SiteFooter business={b} />
  {sticky && <StickyCallBar phoneHref={b.phoneHref} />}
</body>
</html>
