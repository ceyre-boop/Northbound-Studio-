---
// Right-hand drawer, not a page: the whole point of the demo is that ordering
// never leaves the shop until Stripe takes over.
const base = import.meta.env.BASE_URL;
---
<button class="cartbtn" id="cart-open" aria-label="Open cart">
  Cart <span class="cartbtn__n" id="cart-count">0</span>
</button>

<div class="scrim" id="cart-scrim" hidden></div>
<aside class="drawer" id="cart-drawer" data-base={base} aria-label="Your order" aria-hidden="true" inert>
  <header class="drawer__hd">
    <h2>Your order</h2>
    <button class="drawer__x" id="cart-close" aria-label="Close cart">&times;</button>
  </header>

  <div class="drawer__body" id="cart-body"></div>

  <footer class="drawer__ft">
    <fieldset class="ful">
      <legend class="eyebrow">Fulfilment</legend>
      <label class="ful__opt"><input type="radio" name="ful" value="pickup" checked /><span>Pick up in shop</span></label>
      <label class="ful__opt"><input type="radio" name="ful" value="ship" /><span>Ship to me</span></label>
    </fieldset>

    <div class="drawer__sum">
      <span>Subtotal</span>
      <strong id="cart-subtotal">$0.00</strong>
    </div>

    <!-- The honesty label, doubling as an invitation: a visitor who wants to
         test the checkout needs a card number, and a demo store must not look
         like it is taking real money. -->
    <p class="demo-note">
      Demo store — nothing is charged. Use test card
      <code>4242 4242 4242 4242</code>, any future expiry, any CVC.
    </p>

    <button class="btn btn--primary drawer__go" id="cart-checkout" disabled>Checkout</button>
    <p class="drawer__err" id="cart-error" role="status" aria-live="polite"></p>
  </footer>
</aside>

<style>
  .cartbtn {
    display: inline-flex; align-items: center; gap: 0.5rem;
    min-height: 42px; padding: 0.4rem 0.95rem;
    background: transparent; border: 1px solid var(--line); border-radius: 999px;
    font: inherit; font-size: 0.92rem; cursor: pointer;
  }
  .cartbtn:hover { border-color: var(--ink); }
  .cartbtn__n {
    min-width: 21px; height: 21px; padding: 0 5px; display: grid; place-items: center;
    background: var(--espresso); color: var(--bone); border-radius: 999px;
    font-size: 0.72rem; font-weight: 600;
  }
  .scrim { position: fixed; inset: 0; z-index: 80; background: rgba(36,28,23,.4); backdrop-filter: blur(2px); }
  .drawer {
    position: fixed; inset: 0 0 0 auto; z-index: 90;
    width: min(420px, 100%); background: var(--bone);
    border-left: 1px solid var(--line);
    display: flex; flex-direction: column;
    transform: translateX(100%); transition: transform .3s cubic-bezier(0.22,1,0.36,1);
    visibility: hidden;
  }
  .drawer[data-open="true"] { transform: translateX(0); visibility: visible; }
  .drawer__hd { display: flex; align-items: center; justify-content: space-between; padding: 1.1rem var(--gut); border-bottom: 1px solid var(--line-soft); }
  .drawer__hd h2 { font-size: 1.4rem; }
  .drawer__x { background: none; border: 0; font-size: 1.9rem; line-height: 1; cursor: pointer; color: var(--muted); padding: 0 .2rem; }
  .drawer__body { flex: 1; overflow-y: auto; overflow-x: hidden; padding: 0.5rem var(--gut); }
  .drawer__ft { border-top: 1px solid var(--line-soft); padding: 1rem var(--gut) calc(1rem + env(safe-area-inset-bottom)); display: grid; gap: 0.85rem; }
  .drawer__sum { display: flex; justify-content: space-between; align-items: baseline; font-size: 1.05rem; }
  .drawer__sum strong { font-family: var(--display); font-size: 1.4rem; }
  .drawer__go { width: 100%; }
  .drawer__err { margin: 0; font-size: 0.88rem; color: #9A2B12; min-height: 1.1em; }
  .demo-note { margin: 0; font-size: 0.8rem; line-height: 1.5; color: var(--muted); background: var(--bone-2); padding: 0.6rem 0.75rem; border-left: 2px solid var(--sage); }
  .demo-note code { font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: 0.82rem; color: var(--ink); }
  .ful { border: 0; margin: 0; padding: 0; display: grid; gap: 0.4rem; }
  .ful legend { padding: 0; margin-bottom: 0.35rem; }
  .ful__opt { display: flex; align-items: center; gap: 0.55rem; font-size: 0.95rem; cursor: pointer; }
  @media (prefers-reduced-motion: reduce) { .drawer { transition: none; } }
</style>

<style is:global>
  /* Rendered by the cart script at runtime, so these cannot be scoped. */
  .line { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.2rem 1rem; padding: 0.9rem 0; border-bottom: 1px solid var(--line-soft); min-width: 0; }
  .line__n { font-family: var(--display); font-size: 1.05rem; }
  .line__v { grid-column: 1; font-size: 0.85rem; color: var(--muted); }
  .line__p { grid-row: 1; grid-column: 2; font-variant-numeric: tabular-nums; }
  .line__qty { grid-column: 1 / -1; display: flex; align-items: center; gap: 0.5rem; margin-top: 0.4rem; min-width: 0; flex-wrap: wrap; }
  .line__qty button:not(.line__rm) { width: 30px; height: 30px; border: 1px solid var(--line); background: transparent; border-radius: var(--r); cursor: pointer; font: inherit; }
  .line__qty output { min-width: 2ch; text-align: center; font-variant-numeric: tabular-nums; }
  .line__rm { margin-left: auto; flex: none; width: auto; height: auto; padding: 0; background: none; border: 0; color: var(--muted); text-decoration: underline; cursor: pointer; font: inherit; font-size: 0.85rem; white-space: nowrap; }
  .empty { padding: 2.5rem 0; color: var(--muted); text-align: center; }
</style>
