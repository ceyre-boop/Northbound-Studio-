---
import Base from '../../layouts/Base.astro';
import content from '../../content/content.json';
const { services } = content;
const base = import.meta.env.BASE_URL;
---
<Base title="Services" description="Roof replacement, repair, storm damage, gutters and free inspections across Eaton and Ingham counties." sticky={true}>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">What we do</p>
      <h1>Services</h1>
      <p class="lede pg__lede">Five things. We don't do siding, we don't do windows, and we'll tell you who does if you ask.</p>
      <div class="list">
        {services.map((s) => (
          <a class="list__row" href={`${base}/services/${s.slug}`}>
            <div>
              <h2>{s.title}</h2>
              <p>{s.summary}</p>
            </div>
            <span class="list__meta">{s.timeline}<span aria-hidden="true"> →</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .pg__lede { margin: 0.9rem 0 2.5rem; }
  .list { border-top: 1px solid var(--line); }
  .list__row { display: flex; align-items: baseline; justify-content: space-between; gap: 2rem; padding: 1.6rem 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .list__row:hover h2 { color: var(--orange); }
  .list__row h2 { font-size: clamp(1.3rem, 3vw, 1.9rem); margin-bottom: 0.3rem; }
  .list__row p { color: var(--muted); margin: 0; max-width: 52ch; }
  .list__meta { font-family: var(--display); font-size: 0.78rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--orange-text); white-space: nowrap; }
  @media (max-width: 640px) { .list__row { flex-direction: column; gap: 0.6rem; } }
</style>
