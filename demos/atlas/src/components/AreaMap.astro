---
// A drawn SVG, not a map embed: two counties and the towns in them. No
// third-party script, no tiles, no layout shift.
const { area } = Astro.props;
---
<div class="area">
  <svg class="area__svg" viewBox="0 0 320 240" role="img" aria-label="Eaton and Ingham counties, Michigan, the two counties Ridgeline Roofing serves">
    <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
      <path d="M18 34 H158 V206 H18 Z" opacity="0.9" />
      <path d="M162 34 H302 V206 H162 Z" opacity="0.9" />
    </g>
    <g fill="currentColor" opacity="0.06">
      <path d="M18 34 H158 V206 H18 Z" />
    </g>
    <circle cx="66" cy="104" r="5" fill="var(--orange)" />
    <circle cx="214" cy="96" r="4" fill="currentColor" opacity="0.45" />
    <circle cx="238" cy="126" r="4" fill="currentColor" opacity="0.45" />
    <circle cx="96" cy="156" r="4" fill="currentColor" opacity="0.45" />
    <g font-family="var(--display)" font-size="11" fill="currentColor">
      <text x="26" y="26" opacity="0.65">EATON</text>
      <text x="170" y="26" opacity="0.65">INGHAM</text>
      <text x="78" y="108" font-weight="700">Grand Ledge</text>
      <text x="224" y="100" opacity="0.7">Lansing</text>
    </g>
  </svg>
  <div class="area__lists">
    {area.counties.map((c) => (
      <div class="area__county">
        <p class="area__h">{c.name}</p>
        <ul>{c.towns.map((t) => <li>{t}</li>)}</ul>
      </div>
    ))}
  </div>
</div>

<style>
  .area { display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  .area__svg { width: 100%; height: auto; color: var(--ink); }
  .area__lists { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .area__h { font-family: var(--display); font-size: 0.74rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--orange); margin-bottom: 0.5rem; }
  .area__lists ul { list-style: none; margin: 0; padding: 0; }
  .area__lists li { padding-block: 0.2rem; border-bottom: 1px solid var(--line); font-size: 0.97rem; }
  @media (max-width: 820px) { .area { grid-template-columns: 1fr; } }
</style>
