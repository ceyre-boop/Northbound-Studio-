---
import Base from '../layouts/Base.astro';
import content from '../content/content.json';
import StormBanner from '../components/StormBanner.astro';
import AreaMap from '../components/AreaMap.astro';
import BookingForm from '../components/BookingForm.astro';

const { business: b, trustStrip, stormBanner, services, howItWorks, serviceArea } = content;
const base = import.meta.env.BASE_URL;
---
<Base
  title="Roofing in Eaton & Ingham counties"
  description="Ridgeline Roofing — replacement, repair, storm damage and gutters across Eaton and Ingham counties. Free inspections, fixed prices."
  sticky={true}
>
  <StormBanner banner={stormBanner} />

  <!-- Hero ------------------------------------------------------------- -->
  <section class="hero">
    <!-- Drawn, not photographed: no image-generation budget was available for
         this pass. Swapping in a real photograph is this one src plus the alt —
         the scrim and layout already assume a full-bleed raster. -->
    <img
      class="hero__img"
      src={`${base}/hero-roof.svg`}
      alt=""
      width="1600" height="1100" fetchpriority="high" decoding="async"
    />
    <div class="hero__scrim"></div>
    <div class="wrap hero__in on-dark">
      <p class="eyebrow hero__eyebrow">Eaton &amp; Ingham counties, Michigan</p>
      <h1>{b.tagline}</h1>
      <p class="hero__lede">Replacement, repair and storm damage — quoted in your driveway, fixed price, no surprises once we start.</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href={`${base}/book`}>Book a free inspection</a>
        <a class="btn btn--ghost hero__tel" href={b.phoneHref}>
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/></svg>
          {b.phone}
        </a>
      </div>
    </div>
    <ul class="trust">
      {trustStrip.map((t) => <li>{t}</li>)}
    </ul>
  </section>
  <div id="hero-end"></div>

  <!-- Services --------------------------------------------------------- -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">What we do</p>
      <h2 class="svc__title">Five things, done properly.</h2>
      <div class="svc">
        {services.map((s) => (
          <a class="svc__card" href={`${base}/services/${s.slug}`}>
            <h3>{s.title}</h3>
            <p>{s.summary}</p>
            <span class="svc__more">{s.timeline} <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works ----------------------------------------------------- -->
  <section class="section section--dark">
    <div class="wrap">
      <p class="eyebrow">How it works</p>
      <h2>Three steps, and you know the price before we touch anything.</h2>
      <ol class="how">
        {howItWorks.map((h) => (
          <li>
            <span class="how__n">{h.step}</span>
            <h3>{h.title}</h3>
            <p>{h.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Service area ----------------------------------------------------- -->
  <section class="section section--paper2">
    <div class="wrap">
      <p class="eyebrow">Service area</p>
      <h2>{serviceArea.heading}</h2>
      <p class="lede area__lede">{serviceArea.body}</p>
      <AreaMap area={serviceArea} />
    </div>
  </section>

  <!-- Booking ---------------------------------------------------------- -->
  <section class="section" id="book">
    <div class="wrap book">
      <div class="book__copy">
        <p class="eyebrow">Book a free inspection</p>
        <h2>Tell us what's happening up there.</h2>
        <p class="lede">We'll come out, photograph what we find, and give you the number before we leave. If the roof has years left, we'll tell you that too.</p>
        <p class="book__or">Would rather talk? <a href={b.phoneHref}>{b.phone}</a></p>
      </div>
      <div class="book__form">
        <BookingForm />
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { position: relative; isolation: isolate; background: var(--ink); }
  .hero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .hero__scrim {
    position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(100deg, rgba(22,21,15,.94) 0%, rgba(22,21,15,.78) 42%, rgba(22,21,15,.30) 100%);
  }
  .hero__in { padding-block: clamp(4rem, 13vw, 8.5rem) clamp(2.5rem, 6vw, 4rem); color: var(--paper); }
  .hero__eyebrow { margin-bottom: 0.9rem; }
  .hero__lede { color: rgba(246,243,236,.82); font-size: clamp(1.05rem,2.2vw,1.24rem); max-width: 46ch; margin: 1.1rem 0 1.9rem; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .hero__tel { color: var(--paper); }
  .trust {
    position: relative; margin: 0; padding: 0.9rem var(--gut); list-style: none;
    display: flex; flex-wrap: wrap; gap: 0.6rem 1.75rem; justify-content: center;
    background: rgba(22,21,15,.96); border-top: 1px solid var(--line-dark);
    font-family: var(--display); font-size: 0.8rem; font-weight: 600;
    letter-spacing: 0.1em; text-transform: uppercase; color: rgba(246,243,236,.78);
  }
  .trust li { display: flex; align-items: center; gap: 0.55rem; }
  .trust li::before { content: ""; width: 6px; height: 6px; background: var(--orange); border-radius: 50%; flex: none; }

  /* Services */
  .svc__title { margin: 0.6rem 0 2rem; max-width: 20ch; }
  .svc { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .svc__card { background: var(--paper); padding: clamp(1.25rem, 3vw, 1.9rem); text-decoration: none; display: flex; flex-direction: column; gap: 0.5rem; transition: background-color .18s ease; }
  .svc__card:hover { background: #fff; }
  .svc__card p { color: var(--muted); margin: 0; flex: 1; }
  .svc__more { font-family: var(--display); font-size: 0.76rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--orange-text); margin-top: 0.75rem; }
  @media (max-width: 900px) { .svc { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .svc { grid-template-columns: 1fr; } }

  /* How it works */
  .how { list-style: none; margin: 2.25rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.5rem, 4vw, 3rem); }
  .how li { border-top: 2px solid var(--orange); padding-top: 1.1rem; }
  .how__n { font-family: var(--display); font-size: 0.8rem; font-weight: 600; letter-spacing: 0.16em; color: var(--orange); }
  .how h3 { margin: 0.4rem 0 0.5rem; }
  .how p { color: rgba(246,243,236,.72); margin: 0; }
  @media (max-width: 780px) { .how { grid-template-columns: 1fr; } }

  .area__lede { margin: 0.6rem 0 2.25rem; }

  /* Booking */
  .book { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr); gap: clamp(1.75rem, 5vw, 4rem); align-items: start; }
  .book__copy h2 { margin: 0.6rem 0 1rem; }
  .book__or { margin-top: 1.5rem; font-family: var(--display); font-weight: 600; }
  .book__or a { color: var(--orange-text); }
  .book__form { background: var(--paper-2); padding: clamp(1.25rem, 3.5vw, 2rem); border-radius: var(--r); }
  @media (max-width: 860px) { .book { grid-template-columns: 1fr; } }
</style>
